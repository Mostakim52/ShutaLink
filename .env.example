# --- Database (PostgreSQL) ---
# Local Docker: postgres:postgres@localhost:5432/shutalink
# Or a free cloud Postgres (Neon/Supabase) connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shutalink?schema=public"

# --- Redis (webhook deduplication) ---
# Local Docker: redis://localhost:6379 | or Upstash/Redis Cloud connection string
REDIS_URL="redis://localhost:6379"

# --- Trigger.dev ---
# After `npx trigger.dev@latest init`, copy the DEV key from the project dashboard -> API Keys
TRIGGER_SECRET_KEY=""
# NOTE: the project ref (proj_...) lives in trigger.config.ts, not here

# --- AI provider (Groq) ---
# From console.groq.com -> API Keys
GROQ_API_KEY=""

# --- Auth.js (sign-in sessions) ---
# Generate with: npx auth secret
AUTH_SECRET=""

# --- GitHub App (sign-in, issue webhooks, install flow) ---
# Register at github.com/settings/apps -> New GitHub App. See the setup notes:
#   Callback URL:      https://<your-domain>/api/auth/callback/github
#   Setup URL:         https://<your-domain>/api/github/setup  (redirect on update: on)
#   Webhook URL:       https://<your-domain>/api/webhooks/github
#   Webhook secret:    any long random string -> GITHUB_WEBHOOK_SECRET below
#   Permissions:       Issues: Read-only, Metadata: Read-only
#   Events:            Issues, Installation
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
# The last path segment of your app's public page, e.g. "shutalink" in
# https://github.com/apps/shutalink
GITHUB_APP_SLUG=""

# --- GitHub webhook ---
# Invent any long random string; enter the SAME value in the GitHub App's webhook settings
GITHUB_WEBHOOK_SECRET=""

# --- Composio (external actions: Notion, Slack) ---
# API key: dashboard.composio.dev (Platform) -> API Keys (starts with ak_)
# Each signed-in user connects their own Notion/Slack accounts from /onboarding.
COMPOSIO_API_KEY=""

# --- Usage caps (protects free tiers; defaults shown, override if needed) ---
LIMIT_USER_DAILY="15"
LIMIT_USER_BURST_PER_MIN="5"
LIMIT_GLOBAL_DAILY="150"

# --- Notion / Slack defaults (fallbacks when a user hasn't set their own) ---
# 32-char ID from the Notion page URL; share the page with the Notion connection
NOTION_PARENT_PAGE_ID=""
SLACK_DEFAULT_CHANNEL="#general"
SLACK_ALERT_CHANNEL="#incident-alerts"

# --- Demo seed (optional; only used by prisma/seed.ts) ---
# Connected Account IDs: dashboard.composio.dev -> Connected Accounts
COMPOSIO_NOTION_CONNECTED_ACCOUNT_ID=""
COMPOSIO_SLACK_CONNECTED_ACCOUNT_ID=""

# --- Test mode ---
# "true"  = Notion/Slack steps are simulated (no Composio setup needed)
# "false" = real Notion + Slack via Composio
MOCK_INTEGRATIONS="true"
