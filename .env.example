# --- Database (PostgreSQL) ---
# Local Docker: postgres:postgres@localhost:5432/chronoweave
# Or a free cloud Postgres (Neon/Supabase) connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/chronoweave?schema=public"

# --- Redis (webhook deduplication) ---
# Local Docker: redis://localhost:6379 | or Upstash/Redis Cloud connection string
REDIS_URL="redis://localhost:6379"

# --- Trigger.dev ---
# After `npx trigger.dev@latest init`, copy the DEV key from the project dashboard -> API Keys
TRIGGER_SECRET_KEY=""
# NOTE: the project ref (org-slug/project-slug) lives in trigger.config.ts, not here

# --- AI provider (Groq) ---
# From console.groq.com -> API Keys
GROQ_API_KEY=""

# --- GitHub webhook ---
# Invent any long random string; enter the SAME value in the GitHub webhook settings
GITHUB_WEBHOOK_SECRET=""

# --- Composio (external actions: Notion, Slack) ---
# API key: app.composio.dev -> Settings -> API Keys
COMPOSIO_API_KEY=""
# Connected Account IDs: app.composio.dev -> Connected Accounts (after connecting each app)
COMPOSIO_NOTION_CONNECTED_ACCOUNT_ID=""
COMPOSIO_SLACK_CONNECTED_ACCOUNT_ID=""

# --- Notion / Slack targets ---
# 32-char ID from the Notion page URL; share the page with the Composio Notion connection
NOTION_PARENT_PAGE_ID=""
SLACK_DEFAULT_CHANNEL="#general"
SLACK_ALERT_CHANNEL="#incident-alerts"

# --- Test mode ---
# "true"  = Notion/Slack steps are simulated (no Composio setup needed)
# "false" = real Notion + Slack via Composio
MOCK_INTEGRATIONS="true"
